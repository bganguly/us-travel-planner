# GCP project and region
GOOGLE_CLOUD_PROJECT=bikram-java
GOOGLE_CLOUD_LOCATION=us-east1
GOOGLE_GENAI_USE_VERTEXAI=true

# GCS bucket for generated images and RAG source files
GCS_BUCKET_NAME=us-travel-planner-media-bikram

# Vertex AI RAG corpus (set after running scripts/create_rag_corpus.py)
RAG_CORPUS_NAME=
RAG_LOCATION=us-central1

# Agent Runtime resource (set automatically by agents-cli deploy via deployment_metadata.json)
# Can override here if needed:
# REASONING_ENGINE_RESOURCE=projects/<project-number>/locations/us-east1/reasoningEngines/<id>

# Alternatively, use Google AI Studio instead of Vertex AI (comment out Vertex lines above):
# GEMINI_API_KEY=your-api-key-here
